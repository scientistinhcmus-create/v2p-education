rules_version = '2';
// Quy tắc bảo mật cho V2P Education.
// Dán toàn bộ nội dung này vào Firebase Console → Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    // Giáo viên = tài khoản có tài liệu admins/{UID}
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }

    // Ngân hàng câu hỏi: học sinh đã đăng nhập được đọc, chỉ giáo viên được sửa
    match /bank/{qid} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Cấu hình (chủ đề tự thêm, phiên bản ngân hàng)
    match /config/{cid} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Danh sách giáo viên: chỉ thêm/xóa trong Firebase Console
    match /admins/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow write: if false;
    }

    // Hồ sơ + thống kê học sinh: mỗi em chỉ đọc/ghi của mình, giáo viên đọc được tất cả
    match /students/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create, update: if isSelf(uid) || isAdmin();
      allow delete: if isAdmin();

      // Các bài làm
      match /attempts/{aid} {
        allow read: if isSelf(uid) || isAdmin();
        allow create: if isSelf(uid);
        allow update, delete: if isAdmin();
      }
    }
  }
}
