rules_version = '2';
// Quy tắc bảo mật cho V2P Education.
// Dán toàn bộ nội dung này vào Firebase Console → Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }

    // Giáo viên = tài khoản có tài liệu admins/{UID}
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function adminData() { return get(/databases/$(database)/documents/admins/$(request.auth.uid)).data; }
    // Toàn quyền (quản trị) = tài liệu admins không giới hạn môn (không có trường "subjects")
    function isFull() { return isAdmin() && !('subjects' in adminData()); }
    // Giáo viên bộ môn: chỉ sửa câu hỏi của các môn được giao
    function canSubj(s) { return isFull() || (isAdmin() && s in adminData().subjects); }

    // Học sinh đã được duyệt (tài khoản cũ chưa có trường status được coi là đã duyệt)
    function isActive() {
      return signedIn() && exists(/databases/$(database)/documents/students/$(request.auth.uid))
        && get(/databases/$(database)/documents/students/$(request.auth.uid)).data.get('status', 'active') == 'active';
    }
    function canStudy() { return isAdmin() || isActive(); }

    // Ngân hàng câu hỏi: học sinh đã được duyệt mới đọc được
    match /bank/{qid} {
      allow read: if canStudy();
      allow create: if canSubj(request.resource.data.get('subject', 'toan'));
      allow update: if canSubj(resource.data.get('subject', 'toan')) && canSubj(request.resource.data.get('subject', 'toan'));
      allow delete: if canSubj(resource.data.get('subject', 'toan'));
    }

    // Hình vẽ của câu hỏi (đề + lời giải)
    match /bankimg/{qid} {
      allow read: if canStudy();
      allow write: if isAdmin();
    }

    // Cấu hình (chủ đề tự thêm, phiên bản ngân hàng, cấu trúc đề)
    match /config/{cid} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Danh sách giáo viên: chỉ giáo viên toàn quyền được cấp / thu hồi
    match /admins/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow write: if isFull();
    }

    // Hồ sơ + thống kê học sinh
    match /students/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      // Tài khoản mới tự tạo luôn ở trạng thái chờ duyệt
      allow create: if isAdmin() || (isSelf(uid) && request.resource.data.get('status', '') == 'pending');
      // Học sinh tự cập nhật hồ sơ/thống kê nhưng không tự đổi trạng thái duyệt
      allow update: if isAdmin() || (isSelf(uid) && request.resource.data.get('status', 'active') == resource.data.get('status', 'active'));
      allow delete: if isFull();

      // Các bài làm
      match /attempts/{aid} {
        allow read: if isSelf(uid) || isAdmin();
        allow create: if isSelf(uid) && canStudy();
        allow update: if isAdmin();
        allow delete: if isFull();
      }
    }
  }
}
